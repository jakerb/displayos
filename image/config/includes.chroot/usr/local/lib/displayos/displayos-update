#!/usr/bin/env python3
"""Install verified receiver-service bundles from GitHub Releases."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

CONFIG = Path("/etc/displayos/update.json")
STATE = Path("/var/lib/displayos")
ASSET = "displayos-receiver-service.tar.gz"

def log(message):
    print(f"displayos-update: {message}", flush=True)

def download(url, destination):
    request = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "DisplayOS"})
    with urllib.request.urlopen(request, timeout=30) as response, open(destination, "wb") as output:
        shutil.copyfileobj(response, output)

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    if not args.check:
        return
    config = json.loads(CONFIG.read_text())
    api_url = f"https://api.github.com/repos/{config['repository']}/releases/latest"
    try:
        with urllib.request.urlopen(urllib.request.Request(api_url, headers={"Accept": "application/vnd.github+json", "User-Agent": "DisplayOS"}), timeout=15) as response:
            release = json.load(response)
    except Exception as error:
        log(f"update check skipped: {error}")
        return
    assets = {asset["name"]: asset for asset in release.get("assets", [])}
    if ASSET not in assets or f"{ASSET}.sha256" not in assets:
        log("latest release has no receiver-service bundle")
        return
    version = release["tag_name"].lstrip("v")
    releases = STATE / "releases"
    target = releases / version
    if target.is_dir():
        log(f"receiver service {version} already installed")
        return
    with tempfile.TemporaryDirectory(prefix="displayos-update-") as temporary:
        archive = Path(temporary) / ASSET
        checksum = Path(temporary) / "checksum"
        download(assets[ASSET]["browser_download_url"], archive)
        download(assets[f"{ASSET}.sha256"]["browser_download_url"], checksum)
        expected = checksum.read_text().split()[0]
        if sha256(archive) != expected:
            raise RuntimeError("download checksum did not match release asset")
        with tarfile.open(archive, "r:gz") as bundle:
            names = bundle.getnames()
            if any(Path(name).is_absolute() or ".." in Path(name).parts for name in names):
                raise RuntimeError("unsafe path in release bundle")
            bundle.extractall(temporary)
        payload = Path(temporary) / "receiver-service"
        manifest = json.loads((payload / "manifest.json").read_text())
        if manifest.get("version") != version:
            raise RuntimeError("bundle version does not match release tag")
        if not (payload / "announce.py").is_file() or not (payload / "receiver-ui").is_file():
            raise RuntimeError("bundle is missing receiver files")
        releases.mkdir(parents=True, exist_ok=True)
        shutil.move(str(payload), target)
        os.chmod(target / "announce.py", 0o755)
        os.chmod(target / "receiver-ui", 0o755)
        next_link = STATE / "current.next"
        next_link.unlink(missing_ok=True)
        next_link.symlink_to(target)
        os.replace(next_link, STATE / "current")
        log(f"installed receiver service {version}")
        subprocess.run(["systemctl", "try-restart", "displayos-announce.service", "displayos-receiver.service"], check=False)

if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        log(f"update failed: {error}")
        sys.exit(1)
